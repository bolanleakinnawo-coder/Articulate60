      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  html,\n  body {\n    background: #090c0a;\n  }\n\n  .coming-soon-font {\n    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  }\n\n  .coming-soon-card {\n    position: relative;\n    width: min(100%, 704px);\n    aspect-ratio: 1.265 / 1;\n    overflow: hidden;\n    border: 1px solid rgba(196, 209, 168, 0.28);\n    border-radius: 38px;\n    background: #111611;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);\n  }\n\n  .coming-soon-card::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: radial-gradient(circle at 52% 18%, rgba(147, 162, 131, 0.035), transparent 24%), radial-gradient(circle at 25% 82%, rgba(147, 162, 131, 0.025), transparent 32%);\n  }\n\n  .coming-soon-content {\n    position: relative;\n    z-index: 5;\n    display: flex;\n    height: 100%;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 54px 42px 48px;\n    text-align: center;\n  }\n\n  .coming-soon-copy {\n    max-width: 620px;\n  }\n\n  @media (max-width: 560px) {\n    .coming-soon-card {\n      aspect-ratio: auto;\n      min-height: 585px;\n      border-radius: 28px;\n    }\n\n    .coming-soon-content {\n      padding: 48px 24px 42px;\n    }\n\n    .coming-soon-copy {\n      max-width: 31ch;\n    }\n  }\n</style>\n<main class=\"coming-soon-font flex min-h-[700px] w-full items-center justify-center bg-[#090c0a] px-5 py-6 text-[#f5f2e8] sm:min-h-[760px] sm:px-8 sm:py-8\" data-kid=\"1\" data-name=\"page layout container\">\n    <section aria-labelledby=\"coming-soon-title\" class=\"coming-soon-card\" data-kid=\"1-1\" data-name=\"coming soon card container\">\n        <div class=\"pointer-events-none absolute -left-[92px] -top-[112px] z-0 h-[270px] w-[270px] rounded-full bg-[#87977e]/10\" data-kid=\"1-1-1\" data-name=\"decorative background circle top-left\">\n        </div>\n        <div class=\"pointer-events-none absolute -right-[126px] -bottom-[152px] z-0 h-[350px] w-[350px] rounded-full bg-[#77886e]/10\" data-kid=\"1-1-2\" data-name=\"decorative background circle bottom-right\">\n        </div>\n        <div class=\"pointer-events-none absolute left-1/2 top-[82px] z-0 h-[112px] w-[112px] -translate-x-1/2 rounded-full bg-[#7e8d74]/10 blur-[1px]\" data-kid=\"1-1-3\" data-name=\"decorative blurred background circle center\">\n        </div>\n        <div class=\"coming-soon-content\" data-kid=\"1-1-4\" data-name=\"card content wrapper\">\n            <div aria-label=\"Mountain with a flag\" class=\"relative mb-7 h-[104px] w-[138px] text-[#d1ddb7]\" data-kid=\"1-1-4-1\" data-name=\"mountain with flag image\" role=\"img\">\n                <i aria-hidden=\"true\" class=\"absolute bottom-0 left-1/2 h-[94px] w-[128px] -translate-x-1/2 stroke-[1.35]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-1\" data-lucide=\"mountain\" data-name=\"mountain icon\" data-reason=\"icon rendered by lucide library\">\n                </i>\n                <i aria-hidden=\"true\" class=\"absolute right-[18px] top-0 h-[34px] w-[34px] stroke-[1.65]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2\" data-lucide=\"flag\" data-name=\"flag icon\" data-reason=\"icon rendered by lucide library\">\n                </i>\n            </div>\n            <p class=\"mb-3 text-[16px] font-medium uppercase tracking-[0.28em] text-[#c4d1a8] sm:text-[18px]\" data-kid=\"1-1-4-2\" data-name=\"section subtitle text\">\n                Challenges\n            </p>\n            <h1 class=\"mb-6 text-[42px] font-semibold leading-[1.05] tracking-[-0.045em] text-[#f7f7f4] sm:text-[58px]\" data-kid=\"1-1-4-3\" data-name=\"section headline text\" id=\"coming-soon-title\">\n                Coming Soon\n            </h1>\n            <p class=\"coming-soon-copy mb-9 text-[16px] font-normal leading-[1.5] text-[#c5c8c0]/80 sm:text-[20px] sm:leading-[1.45]\" data-kid=\"1-1-4-4\" data-name=\"section description paragraph\">\n                Exciting challenges are on the way to help you improve, grow and become a better communicator.\n            </p>\n            <button aria-label=\"Stay tuned for upcoming challenges\" class=\"inline-flex min-h-[58px] min-w-[188px] items-center justify-center gap-4 rounded-full border border-[#c4d1a8]/35 bg-transparent px-8 text-[18px] font-normal text-[#d9dfc8] transition-colors duration-200 hover:border-[#c4d1a8]/65 hover:bg-[#c4d1a8]/10 hover:text-[#f7f7f4] sm:min-h-[66px] sm:min-w-[218px] sm:text-[22px]\" data-kid=\"1-1-4-5\" data-name=\"stay tuned call-to-action button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"h-6 w-6 stroke-[1.55] sm:h-7 sm:w-7\" data-dynamic=\"true\" data-kid=\"1-1-4-5-1\" data-lucide=\"bell\" data-name=\"bell notification icon\" data-reason=\"icon rendered by lucide library\">\n                </i>\n                <span data-kid=\"1-1-4-5-2\" data-name=\"button label text\">\n                    Stay Tuned\n                </span>\n            </button>\n        </div>\n    </section>\n</main>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    if (window.lucide) {\n    window.lucide.createIcons();\n  }\n</script>\n",
